<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VEModificarUsuario"
             NavigationPage.HasNavigationBar="False"
             Title="ModificarUsuario">
    <Grid RowDefinitions=".1*,.9*">
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Modificar Usuario"
                   x:Name="tituloInterfaz"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>
        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout>
                    <Frame WidthRequest="500"
                           HeightRequest="60"
                           Padding="0,10,0,0"
                           BackgroundColor="AliceBlue"
                           BorderColor="Transparent">
                        <Label Text="Información general"
                               x:Name="TituloLabel"
                               HorizontalOptions="Center"
                               TextColor="Black"
                               FontFamily="Comf-Bold"
                               FontSize="Medium" />
                    </Frame>

                    <!-- Indicador de carga -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#cb4335"
                                       HorizontalOptions="Center"
                                       Margin="0,10" />

                    <!-- Campos para actualizar usuario -->
                    <VerticalStackLayout Margin="0,10,20,0" Spacing="15">
                        <!-- Campo Username -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Nombre de usuario" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="90,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Source="usuario.png" />
                                <Entry Grid.Column="1"
                                       Margin="10"
                                       x:Name="username_entry"
                                       FontFamily="Comf-Bold"
                                       TextColor="Black" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Campo Contraseña -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Contraseña" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="90,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Source="contrasena.png" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <Entry Margin="10,10,0,10"
                                           x:Name="password_entry"
                                           IsPassword="True"
                                           FontFamily="Comf-Bold"
                                           TextColor="Black" />
                                    <Button Grid.Column="1"
                                            x:Name="togglePassword"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            ImageSource="oculto.png"
                                            Margin="0,0,10,0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            BackgroundColor="Transparent"
                                            Clicked="TogglePasswordVisibility"/>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Campo Tipo de Usuario -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Tipo de Usuario" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="90,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Source="tuser.png" />
                                <Picker Grid.Column="1"
                                        Margin="10"
                                        x:Name="tipoUsuario_picker"
                                        Title="Seleccione tipo de usuario"
                                        FontFamily="Comf-Bold"
                                        TextColor="Black"
                                        ItemsSource="{Binding TiposUsuario}"
                                        ItemDisplayBinding="{Binding descripcion}">
                                </Picker>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Campo Estado (sin cambios) -->
                        <Grid ColumnDefinitions=".2*,.8*">
                            <Image WidthRequest="40"
                                   HeightRequest="40"
                                   HorizontalOptions="Center"
                                   Source="status.png" />
                            <HorizontalStackLayout Grid.Column="1" Margin="10" VerticalOptions="Center">
                                <Label Text="Estado: " 
                                       FontFamily="Comf-Bold"
                                       VerticalOptions="Center"/>
                                <Switch x:Name="estado_switch" 
                                        IsToggled="True" 
                                        OnColor="#007AFF"/>
                                <Label x:Name="estado_label" 
                                       Text="Activo" 
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center"
                                       Margin="10,0,0,0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Campo Persona ID -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Persona" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="90,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Source="iduser.png" />
                                <Label Grid.Column="1"
                                        Margin="10"
                                        x:Name="persona_label"
                                        FontFamily="Comf-Bold"
                                        TextColor="Black">
                                </Label>
                            </Grid>
                        </VerticalStackLayout>


        <!-- Campo Empresa -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Empresa (opcional)" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="90,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       Source="cliente2.png" />
                                <Picker Grid.Column="1"
                                        Margin="10"
                                        x:Name="empresa_picker"
                                        Title="Seleccione empresa"
                                        FontFamily="Comf-Bold"
                                        TextColor="Black">
                                </Picker>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Margin="30"
                           Spacing="40"
                           HorizontalOptions="Center">
                        <Button Text="Actualizar Usuario"
                                x:Name="ActualizarUsuario"
                                HeightRequest="50"
                                WidthRequest="150"
                                Clicked="btn_actualizarUsuario"
                                FontFamily="Comf-Medium"
                                BackgroundColor="#cb4335"
                                TextColor="White"
                                CornerRadius="40"
                                HorizontalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>