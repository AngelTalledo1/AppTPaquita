<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AppTransporte.Interfaces.VEUsuarios"
             xmlns:VME="clr-namespace:AppTransporte.viewModel"
             NavigationPage.HasNavigationBar="False"
             Title="VEUsuarios">
    <ContentPage.BindingContext>
        <VME:VMUsuario />
    </ContentPage.BindingContext>

    <Grid RowDefinitions=".1*,.9*">
        <!-- Header Bar -->
        <Grid ColumnDefinitions=".1*,.9*"
              BackgroundColor="#cb4335"
              Padding="20,0,0,0">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atrasUsuario" />
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Gestión de usuarios"
                   x:Name="tituloInterfaz"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="White"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0"/>
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions=".15*,.85*" 
              BackgroundColor="White">

            <!-- Sección de búsqueda y filtros -->
            <VerticalStackLayout Margin="15,10,10,0" Spacing="5">
                <!-- Barra de búsqueda -->
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Buscar por"
                           FontFamily="Comf-SemBold" 
                           VerticalOptions="Center"/>
                    <SearchBar x:Name="UsuarioSearchBar"
                               Text="{Binding TextoBusqueda}"
                               Placeholder="Username"
                               FontFamily="Comf-Reg" />
                </HorizontalStackLayout>

                <!-- Checkbox para filtrar solo activos -->
                <HorizontalStackLayout Spacing="5" Margin="0,10,0,0">
                    <CheckBox IsChecked="{Binding MostrarSoloActivos}" 
                              Color="#cb4335"
                              Margin="-15"
                              VerticalOptions="Center" />
                    <Label Text="Solo usuarios activos" 
                           FontFamily="Comf-Medium" 
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Lista de usuarios -->
            <Grid Grid.Row="1">
            <ScrollView >
                <VerticalStackLayout Margin="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#bc4749"
                                       HorizontalOptions="Center" />
                        <CollectionView x:Name="UsuarioCollectionView"
                                    ItemsSource="{Binding UsuariosFiltrados}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#edf2f4"
                                       Opacity="0.85"
                                       Margin="0,3"
                                       HasShadow="False"
                                       CornerRadius="15"
                                       Padding="10">
                                        <toolkit:Expander>
                                            <toolkit:Expander.Header>
                                                <Grid ColumnDefinitions="1*,.2*"
                                                      RowDefinitions="1*,1*">
                                                    <Label Text="{Binding Username}"
                                                           FontFamily="Comf-Bold" 
                                                           TextColor="Black"
                                                           VerticalOptions="Center"/>
                                                    <Button ImageSource="edit.png"
                                                            WidthRequest="25"
                                                            Clicked="editar_usuario"
                                                            BackgroundColor="Transparent"
                                                            Padding="0"
                                                            CommandParameter="{Binding .}"
                                                            HorizontalOptions="End" />
                                                    <Button ImageSource="eliminar.png"
                                                            Grid.Column="1"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="Transparent"
                                                            Padding="0"
                                                            Clicked="eliminar_usuario"
                                                            WidthRequest="25"
                                                            HorizontalOptions="End" />
                                                </Grid>
                                            </toolkit:Expander.Header>
                                            <VerticalStackLayout>
                                                <Label Text="{Binding TipoUsuario}" FontFamily="Comf-Medium" FontSize="13" TextColor="Black"/>
                                            </VerticalStackLayout>
                                        </toolkit:Expander>
                                    </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
          </Grid>
        </Grid>
    </Grid>
</ContentPage>