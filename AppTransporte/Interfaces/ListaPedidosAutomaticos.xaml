<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.ListaPedidosAutomaticos"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions=".1*,.15*,.65*,.1*">
        <!-- Encabezado -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Pedidos Automáticos"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Filtro por tipo -->
        <Frame Grid.Row="1" 
               BackgroundColor="White" 
               CornerRadius="15" 
               HasShadow="True" 
               Margin="20,5">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*">
                <Label Text="Filtrar pedidos:" 
                       FontFamily="Comf-Bold" 
                       FontSize="14" 
                       Grid.ColumnSpan="1" 
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <!-- Selector de tipo de filtro -->
                <StackLayout Grid.Row="1" Grid.ColumnSpan="1" 
                            Orientation="Horizontal" 
                            HorizontalOptions="Center"
                            Margin="10,-12,0,5">
                    <Button x:Name="BtnFiltroTodos"
                            Text="Todos" 
                            Clicked="Btn_filtroTodos"
                            BackgroundColor="#007AFF"
                            TextColor="White"
                            FontFamily="Comf-Medium"
                            FontSize="12"
                            Padding="10,10"
                            CornerRadius="20"
                            WidthRequest="80"/>
                    <Button x:Name="BtnFiltroHoy"
                            Text="Hoy" 
                            Clicked="Btn_filtroHoy"
                            BackgroundColor="#6c757d"
                            TextColor="White"
                            FontFamily="Comf-Medium"
                            FontSize="12"
                            Padding="20,10"
                            CornerRadius="20"
                            WidthRequest="80"
                            Margin="15,0,0,0"/>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Contenido principal -->
        <Grid Grid.Row="2" Padding="20,10,20,0">
            <!-- Lista vacía -->
            <StackLayout x:Name="EmptyStateLayout" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="No hay pedidos automáticos programados"
                       FontFamily="Comf-Medium"
                       FontSize="16"
                       Margin="50"
                       VerticalOptions="Center"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
                <Label Text="Presiona 'Crear Nuevo Pedido' para empezar"
                       FontFamily="Comf-Regular"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>
            </StackLayout>

            <!-- Lista de pedidos -->
            <ScrollView x:Name="PedidosScrollView">
                <StackLayout x:Name="PedidosStackLayout">
                    <!-- Los pedidos se agregarán aquí dinámicamente -->
                </StackLayout>
            </ScrollView>
        </Grid>

        <!-- Botón crear nuevo -->
        <Button Grid.Row="3"
                Text="Crear Nuevo Pedido"
                HeightRequest="50"
                WidthRequest="250"
                Clicked="Btn_crearNuevo"
                FontFamily="Comf-Bold"
                BackgroundColor="#cb4335"
                TextColor="White"
                CornerRadius="25"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="20"/>
    </Grid>
</ContentPage>