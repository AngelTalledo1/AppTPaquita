<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VistaReporteTrabajosTrabajadorCliente"
             NavigationPage.HasNavigationBar="False"
             Title="Reporte de Trabajos por Trabajador">
    <Grid RowDefinitions=".1*,.9*">
        <!-- Cabecera -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Trabajos por Trabajador"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <!-- Selector de trabajador -->
            <StackLayout Padding="15" BackgroundColor="#f8f9fa">
                <Frame BorderColor="#e0e0e0" BackgroundColor="White" Padding="0" CornerRadius="10">
                    <Picker x:Name="trabajadorPicker" 
                            Title="Seleccione un trabajador" 
                            FontFamily="Comf-Medium"
                            Margin="10"
                            SelectedIndexChanged="TrabajadorPicker_SelectedIndexChanged"/>
                </Frame>

                <!-- Resumen del trabajador -->
                <Frame x:Name="resumenPanel" 
                       BorderColor="#e0e0e0" 
                       BackgroundColor="White" 
                       Margin="0,10,0,0" 
                       Padding="15" 
                       CornerRadius="10"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="NombreCompletoLabel" 
                               Text="Nombre del Trabajador" 
                               FontFamily="Comf-Bold" 
                               TextColor="#333333"
                               FontSize="18"
                               HorizontalOptions="Center"/>
                        <Label x:Name="CategoriaLabel" 
                               Text="Categoría" 
                               FontFamily="Comf-Medium" 
                               TextColor="#555555"
                               HorizontalOptions="Center"/>

                        <BoxView HeightRequest="1" Color="#e0e0e0" Margin="0,5"/>

                        <Grid ColumnDefinitions="*,*,*">
                            <StackLayout HorizontalOptions="Center">
                                <Label Text="Viajes" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="TotalViajesLabel" 
                                       Text="0" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#cb4335"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="Pedidos" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="TotalPedidosLabel" 
                                       Text="0" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#007AFF"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <StackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="Volumen" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="VolumenTransportadoLabel" 
                                       Text="0" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#34C759"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </StackLayout>

            <!-- Detalle de viajes -->
            <Frame Grid.Row="1" BorderColor="#e0e0e0" BackgroundColor="White" Padding="0" Margin="10" CornerRadius="10">
                <Grid RowDefinitions="Auto,*">
                    <Label Text="Detalle de Viajes" 
                           FontFamily="Comf-Bold" 
                           TextColor="#333333"
                           FontSize="16"
                           Margin="15,10" />

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout>
                            <!-- Cabecera de tabla -->
                            <Grid BackgroundColor="#f0f0f0" Padding="10" ColumnDefinitions="Auto,Auto,1*,1*,1*,Auto">
                                <Label Text="#" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="1" 
                                       Text="Fecha" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="2" 
                                       Text="Origen→Destino" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="3" 
                                       Text="Vehículos" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="4" 
                                       Text="Estado" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="5" 
                                       Text="Completado" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <!-- Datos de viajes -->
                            <CollectionView x:Name="viajesCollectionView" 
                                            EmptyView="Seleccione un trabajador para ver sus viajes">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10" ColumnDefinitions="Auto,Auto,1*,1*,1*,Auto">
                                            <Label Text="{Binding id_viaje}" 
                                                   TextColor="#333333" 
                                                   FontFamily="Comf-Medium"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding fecha_programada, StringFormat='{0:dd/MM/yyyy}'}" 
                                                   TextColor="#333333"/>
                                            <Label Grid.Column="2" 
       Text="{Binding OrigenDestino, StringFormat='{0}→{1}'}" 
       TextColor="#333333"
       LineBreakMode="TailTruncation"/>

                                            <VerticalStackLayout Grid.Column="3">
                                                <Label Text="{Binding Tracto}" 
                                                       TextColor="#333333"/>
                                                <Label Text="{Binding Cisterna}" 
                                                       TextColor="#333333"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="4" 
                                                   Text="{Binding UltimoEstado}" 
                                                   TextColor="#333333"/>
                                            <Label Grid.Column="5" 
                                                   Text="{Binding Completado}" 
                                                   TextColor="#333333"
                                                   HorizontalTextAlignment="Center"/>
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" 
                                                             Binding="{Binding Row}" 
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#f5f5f5"/>
                                                </DataTrigger>
                                            </Grid.Triggers>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <Grid Grid.Row="2" 
                  BackgroundColor="#f8f9fa" 
                  Padding="15" 
                  ColumnDefinitions="*,*">
                <Button Text="Exportar PDF" 
                        CornerRadius="20" 
                        BackgroundColor="#007AFF" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        Clicked="ExportarPDF_Clicked"/>
                <Button Grid.Column="1" 
                        Text="Compartir" 
                        CornerRadius="20" 
                        BackgroundColor="#34C759" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        Clicked="Compartir_Clicked"/>
            </Grid>
        </Grid>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="False" 
              BackgroundColor="#80000000"
              Grid.RowSpan="2">
            <Frame CornerRadius="10" 
                   BackgroundColor="White" 
                   WidthRequest="180" 
                   HeightRequest="120"
                   BorderColor="#cb4335"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                      HeightRequest="40" 
                                      WidthRequest="40" 
                                      Color="#cb4335"/>
                    <Label Text="Procesando..." 
                           FontFamily="Comf-Medium"
                           TextColor="#333333"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
