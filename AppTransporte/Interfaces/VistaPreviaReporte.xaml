<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VistaPreviaReporte"
             NavigationPage.HasNavigationBar="False"
             Title="Vista Previa de Reporte">
    <Grid RowDefinitions=".1*,.9*">
        <!-- Cabecera -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Reporte de Trabajador"
                   Grid.Column="1"
                   x:Name="TituloReporte"
                   FontSize="20"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <!-- Encabezado del reporte -->
            <StackLayout Padding="15" BackgroundColor="#f8f9fa">
                <Label x:Name="FechasReporte" 
                       Text="Periodo: 01/03/2025 - 31/03/2025" 
                       FontFamily="Comf-Medium"
                       FontSize="16"/>
                <Label x:Name="TipoReporte" 
                       Text="Reporte Diario" 
                       FontFamily="Comf-Medium"
                       FontSize="14"
                       Margin="0,5,0,0"/>
            </StackLayout>

            <!-- Datos del reporte -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="10" Spacing="15">
                    <!-- Sección de resumen -->
                    <Frame BorderColor="#e0e0e0" BackgroundColor="White" Padding="15" CornerRadius="10">
                        <StackLayout Spacing="15">
                            <Label Text="Resumen del reporte" 
                                   FontFamily="Comf-Bold" 
                                   TextColor="#333333" 
                                   FontSize="16"/>
                            <BoxView HeightRequest="1" Color="#e0e0e0" Margin="0,5"/>

                            <!-- Grid mejorado con 3 columnas para mejor distribución -->
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                <!-- Fila 1 -->
                                <StackLayout HorizontalOptions="Center">
                                    <Label Text="Total trabajadores" 
                                           FontFamily="Comf-Medium" 
                                           TextColor="#555555"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="TotalTrabajadoresLabel" 
                                           Text="5" 
                                           FontFamily="Comf-Bold" 
                                           TextColor="#cb4335"
                                           FontSize="24"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>

                                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                                    <Label Text="Total viajes" 
                                           FontFamily="Comf-Medium" 
                                           TextColor="#555555"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="TotalViajesLabel" 
                                           Text="123" 
                                           FontFamily="Comf-Bold" 
                                           TextColor="#007AFF"
                                           FontSize="24"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>

                                <StackLayout Grid.Column="2" HorizontalOptions="Center">
                                    <Label Text="Volumen total" 
                                           FontFamily="Comf-Medium" 
                                           TextColor="#555555"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="VolumenTotalLabel" 
                                           Text="15,250.00 L" 
                                           FontFamily="Comf-Bold" 
                                           TextColor="#28a745"
                                           FontSize="24"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>

                    <!-- Tabla de datos (SIN columna Seg) -->
                    <Frame BorderColor="#e0e0e0" BackgroundColor="White" Padding="0" CornerRadius="10">
                        <VerticalStackLayout>
                            <!-- Encabezados de tabla mejorados -->
                            <Grid BackgroundColor="#f0f0f0" Padding="12" ColumnDefinitions="2.5*,1.2*,0.8*,1.3*,1.2*">
                                <Label Text="Trabajador" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="1" 
                                       Text="Categoría" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="2" 
                                       Text="Viajes" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="3" 
                                       Text="Volumen (L)" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="4" 
                                       Text="Periodo" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <!-- Contenido dinámico de datos -->
                            <CollectionView x:Name="reporteCollectionView" 
                EmptyView="No hay datos disponibles para el período seleccionado">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12" ColumnDefinitions="2.5*,1.2*,0.8*,1.3*,1.2*">
                                            <Label Text="{Binding NombreCompleto}" 
                       TextColor="#333333" 
                       FontFamily="Comf-Medium"
                       LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1" 
                       Text="{Binding Categoria}" 
                       TextColor="#333333"
                       FontFamily="Comf-Regular"/>
                                            <Label Grid.Column="2" 
                       Text="{Binding TotalViajes, StringFormat='{0:N0}'}" 
                       TextColor="#333333"
                       FontFamily="Comf-Medium"
                       HorizontalTextAlignment="Center"/>

                                            <!-- CORREGIDO: SIN StringFormat que pueda causar problemas -->
                                            <Label Grid.Column="3" 
                       Text="{Binding VolumenTransportado, StringFormat='{0:N0}'}" 
                       TextColor="#333333"
                       FontFamily="Comf-Medium"
                       HorizontalTextAlignment="Center"/>

                                            <Label Grid.Column="4" 
                       Text="{Binding Periodo}" 
                       TextColor="#333333"
                       FontFamily="Comf-Regular"
                       FontSize="12"
                       HorizontalTextAlignment="Center"/>
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" 
                                 Binding="{Binding Row}" 
                                 Value="True">
                                                    <Setter Property="BackgroundColor" Value="#f5f5f5"/>
                                                </DataTrigger>
                                            </Grid.Triggers>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Botones de acción -->
            <Grid Grid.Row="2" 
                  BackgroundColor="#f8f9fa" 
                  Padding="15" 
                  ColumnDefinitions="*,*">
                <Button Text="Exportar PDF" 
                        CornerRadius="20" 
                        BackgroundColor="#007AFF" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        Clicked="ExportarPDF_Clicked"/>
                <Button Grid.Column="1" 
                        Text="Compartir" 
                        CornerRadius="20" 
                        BackgroundColor="#34C759" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        Clicked="Compartir_Clicked"/>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="False" 
              BackgroundColor="#80000000"
              Grid.RowSpan="2">
            <Frame CornerRadius="10" 
                   BackgroundColor="White" 
                   WidthRequest="180" 
                   HeightRequest="120"
                   BorderColor="#cb4335"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                      HeightRequest="40" 
                                      WidthRequest="40" 
                                      Color="#cb4335"/>
                    <Label Text="Procesando PDF..." 
                           FontFamily="Comf-Medium"
                           TextColor="#333333"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>