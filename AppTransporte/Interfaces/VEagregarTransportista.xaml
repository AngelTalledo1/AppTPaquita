<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VEagregarTransportista"
             Title="VEagregarTransportista"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions=".1*,.9*">
        <Grid BackgroundColor="#cb4335"
              ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atrasTrab" />
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   HeightRequest="20"
                   Margin="20"
                   WidthRequest="20" />
            <Label Text=""
                   x:Name="tituloLabel"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="White"
                   FontFamily="Comf-Medium"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   Padding="20,20,0,0" />
        </Grid>
        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout>
                    <Frame WidthRequest="500"
                           HeightRequest="50"
                           Padding="0,10,0,0"
                           BackgroundColor="AliceBlue"
                           BorderColor="Transparent">
                        <Label Text="Informacion General"
                               HorizontalOptions="Center"
                               FontFamily="Comf-Bold"
                               FontSize="Medium" />
                    </Frame>
                    <VerticalStackLayout Spacing="30" Margin="0,20,20,0">
                        <!-- Tipo de trabajador -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Tipo de trabajador" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="rol.png"
                                       HorizontalOptions="Center"/>
                                <Grid Grid.Column="1">
                                    <Picker x:Name="trabajadorPicker"
                                            Title="Seleccione tipo de trabajador"
                                            FontFamily="Comf-Bold"  
                                            SelectedIndexChanged="categoriaPicker_SelectedIndexChanged"
                                            TextColor="Black">
                                        <Picker.Items>
                                            <x:String>Administrador</x:String>
                                            <x:String>Ayudante</x:String>
                                            <x:String>Transportista</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Nombre" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="usuario.png"
                                       HorizontalOptions="Center"/>
                                <Entry BackgroundColor="Transparent"
                                       Grid.Column="1"
                                       x:Name="NombreTrabEntry"
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Apellido -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Apellido" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="usuario.png"
                                       HorizontalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="ApellidoTrabEntry"
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Tipo de Documento -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Tipo Documento" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="tipodoc.png"
                                       HorizontalOptions="Center"/>
                                <Grid Grid.Column="1">
                                    <Picker x:Name="TipoDocumentoTrabPicker"
                                            Title="Tipo"
                                            HorizontalOptions="Center"
                                            FontFamily="Comf-Bold"
                                            TextColor="Black">
                                        <Picker.Items FontFamily="Comf-Bold">
                                            <x:String>DNI</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Entry x:Name="NumeroDocEntry"
                                           Placeholder="Número"
                                           Keyboard="Numeric"
                                           FontFamily="Comf-Medium"
                                           VerticalOptions="Center"
                                           MaxLength="11" />
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Teléfono -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Teléfono" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="telefono.png"
                                       HorizontalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="TelefonoTrabEntry"
                                       FontFamily="Comf-Medium"
                                       Keyboard="Numeric"
                                       MaxLength="9"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Licencia (solo para transportista) -->
                        <VerticalStackLayout Spacing="0" x:Name="licenciaField" IsVisible="False">
                            <Label Text="Licencia" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="licencia.png"
                                       HorizontalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="LicenciaTrabEntry"
                                       FontFamily="Comf-Medium"
                                       MaxLength="9"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Dirección -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Dirección" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="direccion.png"
                                       HorizontalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="DireccionTrabEntry"
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="E-mail" 
                                   FontFamily="Comf-Medium"
                                   TextColor="#666666"
                                   Margin="80,0,0,0"/>
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="email.png"
                                       HorizontalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="EmailTrabEntry"
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- NUEVO: Campo Estado (sin cambios) -->
                        <Grid ColumnDefinitions=".2*,.8*">
                            <Image WidthRequest="40"
                                   HeightRequest="40"
                                   HorizontalOptions="Center"
                                   Source="status.png" />
                            <HorizontalStackLayout Grid.Column="1" Margin="10" VerticalOptions="Center">
                                <Label Text="Estado: " 
                                       FontFamily="Comf-Bold"
                                       VerticalOptions="Center"/>
                                <Switch x:Name="estado_switch" 
                                        IsToggled="True" 
                                        OnColor="#007AFF"/>
                                <Label x:Name="estado_label" 
                                       Text="Activo" 
                                       FontFamily="Comf-Medium"
                                       VerticalOptions="Center"
                                       Margin="10,0,0,0"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Botón de Guardar -->
                        <Button Text="Guardar Trabajador"
                                x:Name="GuardarTrabajador"
                                HeightRequest="50"
                                WidthRequest="300"
                                IsVisible="False"
                                Clicked="Btn_AgregarTrabajador"
                                FontFamily="Comf-Bold"
                                BackgroundColor="#007AFF"
                                TextColor="White"
                                CornerRadius="40"
                                HorizontalOptions="Center" />
                        <Button Text="Actualizar Trabajador"
                                x:Name="ActualizarTrabajador"
                                HeightRequest="50"
                                WidthRequest="300"
                                IsVisible="False"
                                Clicked="ActualizarTrabajador_Clicked"
                                FontFamily="Comf-Bold"
                                BackgroundColor="#007AFF"
                                TextColor="White"
                                CornerRadius="40"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>