<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.ListaPedidosProgramados"
             NavigationPage.HasNavigationBar="False"
             Title="ListaPedidosProgramados">

    <Grid RowDefinitions=".1*,.15*,.75*">
        <!-- Encabezado -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Pedidos Programados"
                   Grid.Column="1"
                   FontSize="18"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Filtros -->
        <Grid Grid.Row="1" Padding="15,10" BackgroundColor="#f8f9fa">
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="15">

                    <!-- Filtro por Estado -->
                    <Frame Padding="10,5" CornerRadius="8" BackgroundColor="White" BorderColor="#dee2e6">
                        <Picker x:Name="EstadoFiltro"
                                Title="Estado"
                                FontFamily="Comf-Medium"
                                FontSize="12"
                                WidthRequest="120"
                                SelectedIndexChanged="OnFiltroChanged">
                            <Picker.Items>
                                <x:String>Todos</x:String>
                                <x:String>Activo</x:String>
                                <x:String>Pausado</x:String>
                                <x:String>Finalizado</x:String>
                                <x:String>Cancelado</x:String>
                            </Picker.Items>
                        </Picker>
                    </Frame>

                    <!-- Filtro por Frecuencia -->
                    <Frame Padding="10,5" CornerRadius="8" BackgroundColor="White" BorderColor="#dee2e6">
                        <Picker x:Name="FrecuenciaFiltro"
                                Title="Frecuencia"
                                FontFamily="Comf-Medium"
                                FontSize="12"
                                WidthRequest="120"
                                SelectedIndexChanged="OnFiltroChanged">
                            <Picker.Items>
                                <x:String>Todas</x:String>
                                <x:String>Diaria</x:String>
                                <x:String>Semanal</x:String>
                                <x:String>Mensual</x:String>
                                <x:String>Personalizada</x:String>
                            </Picker.Items>
                        </Picker>
                    </Frame>

                    <!-- Filtro por Fecha Inicio -->
                    <Frame Padding="10,5" CornerRadius="8" BackgroundColor="White" BorderColor="#dee2e6">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Desde:" FontSize="10" FontFamily="Comf-Medium" TextColor="#6c757d"/>
                            <DatePicker x:Name="FechaInicioFiltro"
                                        FontFamily="Comf-Medium"
                                        FontSize="11"
                                        Format="dd/MM/yy"
                                        DateSelected="OnFiltroChanged"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Filtro por Fecha Fin -->
                    <Frame Padding="10,5" CornerRadius="8" BackgroundColor="White" BorderColor="#dee2e6">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Hasta:" FontSize="10" FontFamily="Comf-Medium" TextColor="#6c757d"/>
                            <DatePicker x:Name="FechaFinFiltro"
                                        FontFamily="Comf-Medium"
                                        FontSize="11"
                                        Format="dd/MM/yy"
                                        DateSelected="OnFiltroChanged"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botón Limpiar Filtros -->
                    <Button Text="Limpiar"
                            FontFamily="Comf-Medium"
                            FontSize="12"
                            BackgroundColor="#6c757d"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="15,5"
                            Clicked="Btn_limpiarFiltros"/>

                    <!-- Botón Refrescar -->
                    <Button Text="🔄"
                            FontFamily="Comf-Medium"
                            FontSize="16"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="10,5"
                            Clicked="Btn_refrescar"/>

                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Lista de Pedidos -->
        <Grid Grid.Row="2">
            <StackLayout>

                <!-- Estadísticas -->
                <Frame Margin="10,5" Padding="10" BackgroundColor="#e9ecef" BorderColor="Transparent" CornerRadius="8">
                    <Label x:Name="EstadisticasLabel"
                           Text="Cargando estadísticas..."
                           FontFamily="Comf-Medium"
                           FontSize="12"
                           TextColor="#495057"
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- ScrollView con lista -->
                <ScrollView VerticalOptions="FillAndExpand">
                    <StackLayout x:Name="ContenedorPedidos" Padding="10,0">

                        <!-- Indicador de carga -->
                        <ActivityIndicator x:Name="LoadingIndicator" 
                                         IsVisible="False" 
                                         IsRunning="False"
                                         Color="#cb4335"
                                         VerticalOptions="CenterAndExpand"
                                         HorizontalOptions="CenterAndExpand"/>

                        <!-- Mensaje cuando no hay datos -->
                        <Label x:Name="MensajeSinDatos"
                               Text="No hay pedidos programados que mostrar"
                               FontFamily="Comf-Medium"
                               FontSize="14"
                               TextColor="#6c757d"
                               HorizontalOptions="Center"
                               VerticalOptions="CenterAndExpand"
                               IsVisible="False"
                               Margin="0,50"/>

                        <!-- CollectionView para los pedidos -->
                        <CollectionView x:Name="PedidosCollectionView"
                                      ItemsSource="{Binding PedidosFiltrados}"
                                      IsVisible="True">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="15" 
                                           Margin="5,5,5,10" 
                                           BackgroundColor="White" 
                                           BorderColor="#dee2e6"
                                           CornerRadius="12"
                                           HasShadow="True">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                            <!-- Fila 1: Título y Estado -->
                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding TipoServicio}"
                                                   FontFamily="Comf-Bold"
                                                   FontSize="16"
                                                   TextColor="#212529"
                                                   VerticalOptions="Center"/>

                                            <Frame Grid.Row="0" Grid.Column="1"
                                                   Padding="8,4"
                                                   CornerRadius="12"
                                                   BorderColor="Transparent"
                                                   VerticalOptions="Center">
                                                <Frame.Style>
                                                    <Style TargetType="Frame">
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Activo">
                                                                <Setter Property="BackgroundColor" Value="#d4edda"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Pausado">
                                                                <Setter Property="BackgroundColor" Value="#fff3cd"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Finalizado">
                                                                <Setter Property="BackgroundColor" Value="#d1ecf1"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Cancelado">
                                                                <Setter Property="BackgroundColor" Value="#f8d7da"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Frame.Style>
                                                <Label Text="{Binding Estado}"
                                                       FontFamily="Comf-Medium"
                                                       FontSize="11"
                                                       TextColor="#495057"/>
                                            </Frame>

                                            <!-- Fila 2: Detalles -->
                                            <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                                                <Label Text="{Binding FrecuenciaDescripcion}"
                                                       FontFamily="Comf-Medium"
                                                       FontSize="12"
                                                       TextColor="#6c757d"/>
                                                <Label Text="{Binding CantidadTexto}"
                                                       FontFamily="Comf-Medium"
                                                       FontSize="12"
                                                       TextColor="#6c757d"/>
                                            </StackLayout>

                                            <!-- Fila 3: Fechas -->
                                            <StackLayout Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                                                <Label Text="{Binding RangoFechas}"
                                                       FontFamily="Comf-Medium"
                                                       FontSize="11"
                                                       TextColor="#868e96"/>
                                                <Label Text="{Binding ProximaEjecucionTexto, StringFormat='⏰ {0}'}"
                                                       FontFamily="Comf-Medium"
                                                       FontSize="11"
                                                       TextColor="#007bff"/>
                                            </StackLayout>

                                            <!-- Fila 4: Botones de acción -->
                                            <StackLayout Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">

                                                <!-- Botón Ejecutar (solo si está listo) -->
                                                <Button Text="▶️ Ejecutar"
                                                        FontFamily="Comf-Medium"
                                                        FontSize="10"
                                                        BackgroundColor="#28a745"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Clicked="Btn_ejecutarPedido"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="IsVisible" Value="False"/>
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Button" Binding="{Binding EstadoDescripcion}" Value="Listo para ejecutar">
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Botón Pausar/Reanudar -->
                                                <Button FontFamily="Comf-Medium"
                                                        FontSize="10"
                                                        BackgroundColor="#ffc107"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Clicked="Btn_pausarReanudar"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Activo">
                                                                    <Setter Property="Text" Value="⏸️ Pausar"/>
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Pausado">
                                                                    <Setter Property="Text" Value="▶️ Reanudar"/>
                                                                    <Setter Property="IsVisible" Value="True"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Finalizado">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Cancelado">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Botón Editar -->
                                                <Button Text="✏️ Editar"
                                                        FontFamily="Comf-Medium"
                                                        FontSize="10"
                                                        BackgroundColor="#007bff"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="10,5"
                                                        Clicked="Btn_editarPedido"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="IsVisible" Value="True"/>
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Finalizado">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Button" Binding="{Binding Estado}" Value="Cancelado">
                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Botón Eliminar -->
                                                <Button Text="🗑️"
                                                        FontFamily="Comf-Medium"
                                                        FontSize="12"
                                                        BackgroundColor="#dc3545"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="8,5"
                                                        Clicked="Btn_eliminarPedido"
                                                        CommandParameter="{Binding .}"/>

                                            </StackLayout>

                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </StackLayout>
                </ScrollView>

            </StackLayout>
        </Grid>

    </Grid>
</ContentPage>