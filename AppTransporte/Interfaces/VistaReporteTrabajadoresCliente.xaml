<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VistaReporteTrabajadoresCliente"
             NavigationPage.HasNavigationBar="False"
             Title="Reporte de Trabajadores">
    <Grid RowDefinitions=".1*,.9*">
        <!-- Cabecera -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Trabajadores Asignados"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <!-- Resumen -->
            <Frame BorderColor="#e0e0e0" BackgroundColor="White" Padding="15" Margin="10" CornerRadius="10">
                <Grid ColumnDefinitions="*,*,*">
                    <StackLayout HorizontalOptions="Center">
                        <Label Text="Trabajadores" 
                               FontFamily="Comf-Bold" 
                               TextColor="#333333"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="TotalTrabajadoresLabel" 
                               Text="0" 
                               FontFamily="Comf-Bold" 
                               TextColor="#cb4335"
                               FontSize="26"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                    <StackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Viajes" 
                               FontFamily="Comf-Bold" 
                               TextColor="#333333"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="TotalViajesLabel" 
                               Text="0" 
                               FontFamily="Comf-Bold" 
                               TextColor="#007AFF"
                               FontSize="26"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                    <StackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label Text="Seguimientos" 
                               FontFamily="Comf-Bold" 
                               TextColor="#333333"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="TotalSeguimientosLabel" 
                               Text="0" 
                               FontFamily="Comf-Bold" 
                               TextColor="#34C759"
                               FontSize="26"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Tabla de trabajadores -->
            <Frame Grid.Row="1" BorderColor="#e0e0e0" BackgroundColor="White" Padding="0" Margin="10" CornerRadius="10">
                <Grid RowDefinitions="Auto,*">
                    <!-- Título -->
                    <Label Text="Detalle de Trabajadores" 
                           FontFamily="Comf-Bold" 
                           TextColor="#333333"
                           FontSize="16"
                           Margin="15,10" />

                    <!-- Tabla de trabajadores -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout>
                            <!-- Cabecera de tabla -->
                            <Grid BackgroundColor="#f0f0f0" Padding="10" ColumnDefinitions="2*,1*,1*,1*,1*">
                                <Label Text="Nombre" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="1" 
                                       Text="Categoría" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"/>
                                <Label Grid.Column="2" 
                                       Text="Viajes" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="3" 
                                       Text="Seguim." 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="4" 
                                       Text="Volumen" 
                                       FontFamily="Comf-Bold" 
                                       TextColor="#333333"
                                       HorizontalTextAlignment="Center"/>
                            </Grid>

                            <!-- Datos de trabajadores -->
                            <CollectionView x:Name="trabajadoresCollectionView" 
                                            EmptyView="No hay trabajadores asignados para este cliente">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10" ColumnDefinitions="2*,1*,1*,1*,1*">
                                            <Label Text="{Binding Nombre}" 
                                                   TextColor="#333333" 
                                                   FontFamily="Comf-Medium"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding categoria_desc}" 
                                                   TextColor="#333333"/>
                                            <Label Grid.Column="2" 
                                                   Text="{Binding total_viajes}" 
                                                   TextColor="#333333"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Grid.Column="3" 
                                                   Text="{Binding total_seguimientos}" 
                                                   TextColor="#333333"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Grid.Column="4" 
                                                   Text="{Binding volumen_transportado}" 
                                                   TextColor="#333333"
                                                   HorizontalTextAlignment="Center"/>
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" 
                                                             Binding="{Binding Row}" 
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#f5f5f5"/>
                                                </DataTrigger>
                                            </Grid.Triggers>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Frame>

            <!-- Botones de acción -->
            <Grid Grid.Row="2" 
                  BackgroundColor="#f8f9fa" 
                  Padding="15" 
                  ColumnDefinitions="*,*">
                <Button Text="Exportar PDF" 
                        CornerRadius="20" 
                        BackgroundColor="#007AFF" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        />
                <Button Grid.Column="1" 
                        Text="Compartir" 
                        CornerRadius="20" 
                        BackgroundColor="#34C759" 
                        TextColor="White" 
                        FontFamily="Comf-Medium" 
                        HeightRequest="45" 
                        Margin="5,0" 
                        />
            </Grid>
        </Grid>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="False" 
              BackgroundColor="#80000000"
              Grid.RowSpan="2">
            <Frame CornerRadius="10" 
                   BackgroundColor="White" 
                   WidthRequest="180" 
                   HeightRequest="120"
                   BorderColor="#cb4335"
                   HasShadow="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                      HeightRequest="40" 
                                      WidthRequest="40" 
                                      Color="#cb4335"/>
                    <Label Text="Procesando..." 
                           FontFamily="Comf-Medium"
                           TextColor="#333333"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
