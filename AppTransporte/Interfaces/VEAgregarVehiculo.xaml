<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.VEAgregarVehiculo"
             NavigationPage.HasNavigationBar="False"
             Title="VEAgregarVehiculo">
    <Grid RowDefinitions=".1*,.9*">
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#cb4335">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atrasAggVehiculo" />
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text=""
                   x:Name="TituloVehiculo"
                   Grid.Column="1"
                   FontSize="20"
                   TextColor="White"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>
        <Grid Grid.Row="1">
            <ScrollView>
               <VerticalStackLayout>
                
                    <VerticalStackLayout>
                        <Frame WidthRequest="500"
                               HeightRequest="60"
                               Padding="0,10,0,0"
                               BackgroundColor="AliceBlue" 
                               BorderColor="Transparent">
                            <Label Text="Informacion de vehiculo"
                                   HorizontalOptions="Center"
                                   TextColor="Black"
                                   FontFamily="Comf-Bold"
                                   FontSize="Medium" />
                        </Frame>
                        <VerticalStackLayout Margin="10">
                            <Frame Margin="0"
                                   Padding="0"
                                   BorderColor="Transparent"
                                   BackgroundColor="#edede9">
                                <Picker TextColor="Black"
                                        Margin="20,0,0,0"
                                        FontFamily="Comf-Bold"
                                        x:Name="TipovehiculoPicker"
                                        Title="Seleccionar Vehiculo"
                                        HorizontalTextAlignment="Center"
                                        HorizontalOptions="Center"
                                        SelectedIndexChanged="PickerIndexChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Tracto</x:String>
                                            <x:String>Cisterna</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>

                            <!-- Placa -->
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Placa" 
                                       FontFamily="Comf-Medium"
                                       TextColor="#666666"
                                       Margin="90,0,0,0"/>
                                <Grid ColumnDefinitions=".2*,.8*">
                                    <Image WidthRequest="40"
                                           HeightRequest="40"
                                           HorizontalOptions="Center"
                                           Source="licencia.png" />
                                    <Entry Grid.Column="1"
                                           Margin="10"
                                           x:Name="placaEntry"
                                           FontFamily="Comf-Medium"
                                           TextColor="Black" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Modelo (solo Tracto) - Sin cambios -->
                            <Grid ColumnDefinitions=".2*,.8*"
                                  x:Name="tractoFields"
                                  IsVisible="False">
                                <Image WidthRequest="40"
                                       HeightRequest="40"
                                       Source="cisterna.png"
                                       HorizontalOptions="Center" />
                                <Entry PlaceholderColor="#515a5a"
                                       Grid.Column="1"
                                       x:Name="modeloEntry"
                                       Placeholder="Modelo"
                                       Margin="10"
                                       FontFamily="Comf-Medium"
                                       TextColor="Black" />
                            </Grid>

                            <!-- Año de fabricación -->
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Año de fabricación" 
                                       FontFamily="Comf-Medium"
                                       TextColor="#666666"
                                       Margin="90,0,0,0"/>
                                <Grid ColumnDefinitions=".2*,.8*">
                                    <Image WidthRequest="20"
                                           HeightRequest="20"
                                           Source="fabricar.png"
                                           HorizontalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Margin="10"
                                           x:Name="añofabricacionEntry"
                                           FontFamily="Comf-Medium"
                                           TextColor="Black" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Fecha emisión póliza -->
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       Source="calendario.png"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de emisión de póliza"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="emipolizaDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Fecha vencimiento póliza -->
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       Source="vencimiento.png"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de vencimiento de póliza"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="venpolizaDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Fecha emisión CITV -->
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       Source="calendario.png"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de emisión de CITV"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="emicitvDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Fecha vencimiento CITV -->
                            <Grid ColumnDefinitions=".2*,.8*">
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       HorizontalOptions="Center"
                                       Source="vencimiento.png" />
                                <VerticalStackLayout Grid.Column="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de vencimiento CITV"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="venCITVDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Fechas específicas para cisterna -->
                            <Grid ColumnDefinitions=".2*,.8*"
                                  x:Name="cisternaFields"
                                  IsVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fecha emisión cubicación -->
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       Grid.Row="0"
                                       Source="calendario.png"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de emisión de cubicación"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="emicubDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>

                                <!-- Fecha vencimiento cubicación -->
                                <Image WidthRequest="30"
                                       HeightRequest="30"
                                       Grid.Row="1"
                                       Source="vencimiento.png"
                                       HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Grid.Row="1" Margin="10" Spacing="5">
                                    <Label Text="Fecha de vencimiento de cubicación"
                                           FontSize="12"
                                           FontFamily="Comf-Medium"
                                           TextColor="#515a5a" />
                                    <DatePicker x:Name="vencubDatePicker"
                                                BackgroundColor="#f8f9fa"
                                                TextColor="Black"
                                                FontFamily="Comf-Medium"
                                                Format="dd/MM/yyyy" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Botones -->
                            
                            <HorizontalStackLayout Spacing="10"
                                                   HorizontalOptions="Center">
                                <Button Text="Agregar"
                                        x:Name="AgregarVehiculo"
                                        IsVisible="False"
                                        HeightRequest="50"
                                        WidthRequest="150"
                                        Margin="10"
                                        Clicked="AgregarVehiculo_Clicked"
                                        FontFamily="Comf-Bold"
                                        BackgroundColor="#007AFF"
                                        TextColor="White"
                                        CornerRadius="40"
                                        HorizontalOptions="Center" />
                                <Button Text="Cancelar"
                                        x:Name="CancelarVehiculo"
                                        IsVisible="False"
                                        HeightRequest="50"
                                        WidthRequest="150"
                                        FontFamily="Comf-Bold"
                                        BackgroundColor="#cb4335"
                                        Clicked="Btn_atrasAggVehiculo"
                                        TextColor="White"
                                        CornerRadius="40"
                                        HorizontalOptions="Center" />
                                <Button Text="Modificar"
                                        x:Name="ModificarVehiculo"
                                        IsVisible="False"
                                        HeightRequest="50"
                                        WidthRequest="150"
                                        Clicked="ModificarVehiculo_Clicked"
                                        Margin="10"
                                        FontFamily="Comf-Bold"
                                        BackgroundColor="#007AFF"
                                        TextColor="White"
                                        CornerRadius="40"
                                        HorizontalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
            </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>