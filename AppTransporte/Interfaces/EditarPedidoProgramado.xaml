<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTransporte.Interfaces.EditarPedidoProgramado"
             NavigationPage.HasNavigationBar="False"
             Title="EditarPedidoProgramado">

    <Grid RowDefinitions=".1*,.9*">
        <!-- Encabezado -->
        <Grid ColumnDefinitions=".1*,.9*"
              Padding="20,0,0,0"
              BackgroundColor="#007bff">
            <Button BackgroundColor="Transparent"
                    Clicked="Btn_atras"/>
            <Image Source="atras.png"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="20"
                   HeightRequest="20"
                   WidthRequest="20" />
            <Label Text="Editar Pedido Programado"
                   Grid.Column="1"
                   FontSize="18"
                   TextColor="AliceBlue"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontFamily="Comf-Medium"
                   Padding="20,20,0,0" />
        </Grid>

        <!-- Contenido -->
        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout>

                    <!-- Información del pedido -->
                    <Frame WidthRequest="500"
                           HeightRequest="80"
                           Padding="10"
                           BackgroundColor="#e3f2fd"
                           BorderColor="Transparent"
                           Margin="10">
                        <VerticalStackLayout Spacing="5">
                            <Label x:Name="InfoPedidoLabel"
                                   Text="Cargando información..."
                                   HorizontalOptions="Center"
                                   TextColor="#1976d2"
                                   FontFamily="Comf-Bold"
                                   FontSize="14" />
                            <Label x:Name="EstadoActualLabel"
                                   Text=""
                                   HorizontalOptions="Center"
                                   TextColor="#424242"
                                   FontFamily="Comf-Medium"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Frame>

                    <VerticalStackLayout Spacing="25" Margin="30,10,20,0">

                        <!-- Tipo de Servicio -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="tiposervicio.png" VerticalOptions="Center" />
                            <Picker x:Name="TipoServicioPicker"
                                    Title="Tipo de Servicio"
                                    FontFamily="Comf-Medium"
                                    HorizontalOptions="FillAndExpand">
                                <Picker.Items>
                                    <x:String>Regado</x:String>
                                    <x:String>Transporte de Fluido</x:String>
                                    <x:String>Suministro de Agua</x:String>
                                    <x:String>Transporte de Agua</x:String>
                                    <x:String>Transporte de Combustible</x:String>
                                    <x:String>Transporte de Químicos</x:String>
                                </Picker.Items>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Frecuencia -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="frecuencia.png" VerticalOptions="Center" />
                            <Picker x:Name="FrecuenciaPicker"
                                    Title="Frecuencia"
                                    FontFamily="Comf-Medium"
                                    SelectedIndexChanged="OnFrecuenciaChanged"
                                    HorizontalOptions="FillAndExpand">
                                <Picker.Items>
                                    <x:String>Diaria</x:String>
                                    <x:String>Semanal</x:String>
                                    <x:String>Mensual</x:String>
                                    <x:String>Personalizada</x:String>
                                </Picker.Items>
                            </Picker>
                        </HorizontalStackLayout>

                        <!-- Días personalizados -->
                        <StackLayout x:Name="DiasSeleccionadosLayout" Padding="10" IsVisible="False">
                            <Label Text="Seleccione los días:" FontFamily="Comf-Medium" Padding="5" HorizontalOptions="Center"/>
                            <Grid>
                                <Grid ColumnDefinitions="auto, auto, auto" RowDefinitions="auto, auto, auto">
                                    <Label FontFamily="Comf-Medium" Grid.Row="0" Grid.Column="0" Text="Lunes" VerticalOptions="Center"/>
                                    <CheckBox Color="#007bff" Grid.Row="0" Grid.Column="1" x:Name="LunesCheck" HorizontalOptions="Start"/>
                                    <Label FontFamily="Comf-Medium" VerticalOptions="Center" Grid.Row="1" Grid.Column="0" Text="Martes"/>
                                    <CheckBox Color="#007bff" Grid.Row="1" Grid.Column="1" x:Name="MartesCheck"/>
                                    <Label FontFamily="Comf-Medium" VerticalOptions="Center" Grid.Row="2" Grid.Column="0" Text="Miércoles"/>
                                    <CheckBox Color="#007bff" Grid.Row="2" Grid.Column="1" x:Name="MiercolesCheck"/>
                                </Grid>
                                <Grid ColumnDefinitions="1*, 5*, 2*,3*" RowDefinitions="auto,auto,auto">
                                    <Label FontFamily="Comf-Medium" VerticalOptions="Center" Grid.Row="0" Grid.Column="2" Text="Jueves"/>
                                    <CheckBox Color="#007bff" Grid.Row="0" Grid.Column="3" x:Name="JuevesCheck"/>
                                    <Label Padding="-2" FontFamily="Comf-Medium" VerticalOptions="Center" Grid.Row="1" Grid.Column="2" Text="Viernes"/>
                                    <CheckBox Color="#007bff" Grid.Row="1" Grid.Column="3" x:Name="ViernesCheck"/>
                                    <Label Padding="-2" FontFamily="Comf-Medium" VerticalOptions="Center" Grid.Row="2" Grid.Column="2" Text="Sábado"/>
                                    <CheckBox Color="#007bff" Grid.Row="2" Grid.Column="3" x:Name="SabadoCheck"/>
                                </Grid>
                            </Grid>
                        </StackLayout>

                        <!-- Fecha inicio -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="calendario.png" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="-5" HorizontalOptions="FillAndExpand">
                                <Label Text="Fecha de Inicio:"
                                       FontFamily="Comf-Medium"
                                       TextColor="#007bff"/>
                                <DatePicker FontFamily="Comf-Medium"
                                            x:Name="FechaInicioPicker"
                                            Format="dd/MM/yyyy"
                                            DateSelected="FechaInicioPicker_DateSelected"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Fecha fin -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="calendario.png" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="-5" HorizontalOptions="FillAndExpand">
                                <Label Text="Fecha de Finalización:"
                                       FontFamily="Comf-Medium"
                                       TextColor="#007bff"/>
                                <DatePicker x:Name="FechaFinPicker"
                                            FontFamily="Comf-Medium"
                                            Format="dd/MM/yyyy"
                                            DateSelected="FechaFinPicker_DateSelected"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Hora -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="reloj.png" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="-5" HorizontalOptions="FillAndExpand">
                                <Label Text="Hora Programada:"
                                       FontFamily="Comf-Medium"
                                       TextColor="#007bff"/>
                                <TimePicker x:Name="HoraPicker" FontFamily="Comf-Medium"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Cantidad -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="cantidad.png" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="-5" HorizontalOptions="FillAndExpand">
                                <Label Text="Cantidad en Barriles:"
                                       FontFamily="Comf-Medium"
                                       TextColor="#007bff"/>
                                <Entry x:Name="CantidadEntry"
                                       Placeholder="Cantidad en barriles"
                                       FontFamily="Comf-Medium"
                                       Keyboard="Numeric"
                                       TextChanged="CantidadEntry_TextChanged"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Información de conversión -->
                        <Label x:Name="ConversionLabel"
                               FontFamily="Comf-Medium"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center"
                               Margin="0,-15,0,0"/>

                        <!-- Descripción -->
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Image WidthRequest="30" HeightRequest="30" Source="descripcion.png" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="-5" HorizontalOptions="FillAndExpand">
                                <Label Text="Descripción (Opcional):"
                                       FontFamily="Comf-Medium"
                                       TextColor="#007bff"/>
                                <Entry x:Name="DescripcionEntry"
                                       Placeholder="Descripción adicional del pedido"
                                       FontFamily="Comf-Medium"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Información de ejecuciones -->
                        <Frame Padding="15" BackgroundColor="#f8f9fa" BorderColor="#dee2e6" CornerRadius="8">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="📊 Información de Ejecuciones"
                                       FontFamily="Comf-Bold"
                                       FontSize="14"
                                       TextColor="#495057"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="EjecucionesInfoLabel"
                                       Text="Cargando..."
                                       FontFamily="Comf-Medium"
                                       FontSize="12"
                                       TextColor="#6c757d"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Advertencias -->
                        <Frame x:Name="AdvertenciaFrame" 
                               Padding="10" 
                               BackgroundColor="#fff3cd" 
                               BorderColor="#ffeaa7" 
                               CornerRadius="8"
                               IsVisible="False">
                            <Label x:Name="AdvertenciaLabel"
                                   FontFamily="Comf-Medium"
                                   FontSize="12"
                                   TextColor="#856404"
                                   HorizontalOptions="Center"/>
                        </Frame>

                        <!-- Botones -->
                        <Grid Padding="0,20,0,30">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="15">

                                <Button Text="💾 Guardar Cambios"
                                        x:Name="GuardarButton"
                                        HeightRequest="50"
                                        WidthRequest="250"
                                        Clicked="Btn_guardarCambios"
                                        FontFamily="Comf-Bold"
                                        BackgroundColor="#28a745"
                                        TextColor="White"
                                        CornerRadius="25"/>

                                <Button Text="🔄 Recalcular Próxima Ejecución"
                                        HeightRequest="45"
                                        WidthRequest="250"
                                        Clicked="Btn_recalcularEjecucion"
                                        FontFamily="Comf-Medium"
                                        BackgroundColor="#17a2b8"
                                        TextColor="White"
                                        CornerRadius="20"/>

                                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                                    <Button Text="⏸️ Pausar"
                                            x:Name="PausarButton"
                                            HeightRequest="40"
                                            WidthRequest="110"
                                            Clicked="Btn_pausarPedido"
                                            FontFamily="Comf-Medium"
                                            BackgroundColor="#ffc107"
                                            TextColor="White"
                                            CornerRadius="15"/>

                                    <Button Text="🗑️ Eliminar"
                                            HeightRequest="40"
                                            WidthRequest="110"
                                            Clicked="Btn_eliminarPedido"
                                            FontFamily="Comf-Medium"
                                            BackgroundColor="#dc3545"
                                            TextColor="White"
                                            CornerRadius="15"/>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>